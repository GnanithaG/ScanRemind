# Copy to .env and fill in. Never commit .env.

# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Public URL of the reminder form; the QR code points here.
# Defaults to this server's /set-reminder page.
APP_URL=https://your-domain.example/set-reminder

# Email. "brevo" sends real email; "console" just logs it (good for local dev).
MAIL_BACKEND=console
BREVO_API_KEY=
MAIL_SENDER_EMAIL=reminders@your-domain.example
MAIL_SENDER_NAME=ScanRemind

# Where the SQLite database lives.
DATABASE_PATH=reminders.db

# Local development only: debug mode and cookies over plain http.
FLASK_DEBUG=true
SESSION_COOKIE_SECURE=false

# Set to false if you run `flask --app wsgi send-due` from cron instead.
RUN_SCHEDULER=true
